ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}
ARG WITH_WEBKIT=false
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python3-gi gir1.2-gtk-3.0 gir1.2-atspi-2.0 at-spi2-core dbus-x11 xvfb xauth gsettings-desktop-schemas libglib2.0-bin dconf-gsettings-backend && rm -rf /var/lib/apt/lists/*
# Rollback qualification requires complete selected-package file inventories;
# Debian slim otherwise deliberately omits installed documentation members.
RUN rm -f /etc/dpkg/dpkg.cfg.d/docker && apt-get update && apt-get install -y --no-install-recommends git git-lfs sudo dpkg-repack fakeroot
RUN useradd --uid 10001 --no-create-home fixture && echo 'fixture ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/fixture
RUN if [ "$WITH_WEBKIT" = true ]; then apt-get update && apt-get install -y --no-install-recommends gir1.2-webkit2-4.1; elif [ "$WITH_WEBKIT" != false ]; then exit 1; fi
