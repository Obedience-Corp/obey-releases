FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-gi gir1.2-gtk-3.0 gir1.2-atspi-2.0 at-spi2-core dbus-x11 xvfb xauth gsettings-desktop-schemas libglib2.0-bin dconf-gsettings-backend && rm -rf /var/lib/apt/lists/*
# Rollback qualification requires complete selected-package file inventories;
# Debian slim otherwise deliberately omits installed documentation members.
RUN rm /etc/dpkg/dpkg.cfg.d/docker && apt-get update && apt-get install -y --no-install-recommends git git-lfs sudo dpkg-repack fakeroot
RUN useradd --uid 10001 --no-create-home fixture && echo 'fixture ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/fixture
